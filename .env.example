# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL 18 (Docker Compose)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp_db
DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5432/erp_db?schema=public

# Redis 7 (Docker Compose)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=erp:

# Better Auth
# Set a strong random 32+ char secret in production (e.g., openssl rand -hex 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Studio Runtime (Optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
