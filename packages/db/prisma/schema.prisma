generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// Better Auth Core & Organization Models
// ==========================================

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id             String          @id
  name           String
  slug           String          @unique
  logo           String?
  createdAt      DateTime        @default(now())
  metadata       String?
  members        Member[]
  invitations    Invitation[]
  tenantSettings TenantSettings?
  auditLogs      AuditLog[]
  items              Item[]
  itemRevisions      ItemRevision[]
  locations          Location[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  stockTransfers     StockTransfer[]
  stockTransferLines StockTransferLine[]
  suppliers          Supplier[]
  supplierItems      SupplierItem[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceipts      GoodsReceipt[]
  goodsReceiptLines  GoodsReceiptLine[]
  vendorBills        VendorBill[]
  vendorBillLines    VendorBillLine[]
  storedObjects      StoredObject[]
  departments        Department[]
  workSchedules      WorkSchedule[]
  staffProfiles      StaffProfile[]
  holidays           Holiday[]
  timeOffRequests    TimeOffRequest[]
  teams              Team[]
  teamMembers        TeamMember[]
  calendarFeeds      CalendarFeed[]
  crmConnection         CrmConnection?
  crmStaffMappings      CrmStaffMapping[]
  crmDealItemLinks      CrmDealItemLink[]
  crmWebhookEvents      CrmWebhookEvent[]
  itemPacks             ItemPack[]
  itemBundleComponents  ItemBundleComponent[]
  servicePlans          ServicePlan[]
  priceBooks            PriceBook[]
  priceRules            PriceRule[]
  priceTiers            PriceTier[]
  discountRules         DiscountRule[]

  @@map("organization")
}

model Member {
  id             String        @id
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String        @default("member")
  createdAt      DateTime      @default(now())
  staffProfile   StaffProfile?

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ==========================================
// Multi-Tenant ERP Base Scaffold Models
// ==========================================

model TenantSettings {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyLegalName     String?
  defaultCurrency      String       @default("USD")
  timezone             String       @default("UTC")
  fiscalYearStartMonth Int          @default(1)
  storageBucket        String?      @unique
  storageQuotaBytes    BigInt       @default(1073741824)
  features             Json?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("tenant_settings")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

// ==========================================
// Items & Services Catalog Models
// ==========================================

enum ItemType {
  SELLABLE
  MERCH
  RAW_MATERIAL
  SERVICE
  CONSUMABLE
}

enum ItemStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ItemRevisionAction {
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
}

model Item {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sku                String
  name               String
  description        String?
  type               ItemType
  status             ItemStatus     @default(ACTIVE)
  unitOfMeasure      String         @default("unit")
  currency           String         @default("USD")
  salePriceCents     Int            @default(0)
  costPriceCents     Int            @default(0)
  trackInventory     Boolean        @default(true)
  allowNegativeStock Boolean        @default(false)
  reorderPoint       Int?
  isBundle           Boolean             @default(false)
  tags               String[]            @default([])
  metadata           Json?
  version            Int                 @default(1)
  createdByUserId    String?
  updatedByUserId    String?
  archivedAt         DateTime?
  archivedByUserId   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  revisions          ItemRevision[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  stockTransferLines StockTransferLine[]
  supplierItems      SupplierItem[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  vendorBillLines    VendorBillLine[]
  crmDealLinks       CrmDealItemLink[]
  packs              ItemPack[]
  bundleComponents   ItemBundleComponent[] @relation("BundleParentItem")
  includedInBundles  ItemBundleComponent[] @relation("BundleComponentItem")
  servicePlans       ServicePlan[]
  priceRules         PriceRule[]
  discountRules      DiscountRule[]

  @@unique([organizationId, sku])
  @@index([organizationId, status, type])
  @@index([organizationId, updatedAt])
  @@map("item")
}

model ItemRevision {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item               @relation(fields: [itemId], references: [id], onDelete: Cascade)
  version        Int
  action         ItemRevisionAction
  changes        Json
  reason         String?
  actorUserId    String?
  createdAt      DateTime           @default(now())

  @@unique([itemId, version])
  @@index([organizationId, itemId, version])
  @@map("item_revision")
}

// ==========================================
// Multi-Location & Inventory Models
// ==========================================

enum LocationType {
  WAREHOUSE
  RETAIL_STORE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockMovementType {
  RECEIPT
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model Location {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  name              String
  type              LocationType
  status            LocationStatus  @default(ACTIVE)
  isDefault         Boolean         @default(false)
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  timezone          String?
  phone             String?
  email             String?
  metadata          Json?
  createdByUserId   String?
  updatedByUserId   String?
  archivedAt        DateTime?
  archivedByUserId  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  outgoingTransfers StockTransfer[] @relation("TransferFromLocation")
  incomingTransfers StockTransfer[] @relation("TransferToLocation")
  purchaseOrders    PurchaseOrder[]
  goodsReceipts     GoodsReceipt[]
  staffProfiles     StaffProfile[]
  holidays          Holiday[]

  @@unique([organizationId, code])
  @@index([organizationId, status, type])
  @@map("location")
}

model StockBalance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  onHandQty      Int          @default(0)
  reservedQty    Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, itemId, locationId])
  @@index([organizationId, locationId])
  @@index([organizationId, itemId])
  @@map("stock_balance")
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type           StockMovementType
  quantityDelta  Int
  balanceAfter   Int
  referenceType  String?
  referenceId    String?
  reason         String?
  actorUserId    String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, itemId, locationId, createdAt])
  @@index([organizationId, createdAt])
  @@map("stock_movement")
}

model StockTransfer {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transferNumber     String
  fromLocationId     String
  fromLocation       Location            @relation("TransferFromLocation", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId       String
  toLocation         Location            @relation("TransferToLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  status             StockTransferStatus @default(DRAFT)
  notes              String?
  createdByUserId    String?
  dispatchedByUserId String?
  dispatchedAt       DateTime?
  receivedByUserId   String?
  receivedAt         DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lines              StockTransferLine[]

  @@unique([organizationId, transferNumber])
  @@index([organizationId, status])
  @@map("stock_transfer")
}

model StockTransferLine {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity        Int
  createdAt       DateTime      @default(now())

  @@unique([stockTransferId, itemId])
  @@index([organizationId, stockTransferId])
  @@map("stock_transfer_line")
}

// ==========================================
// Supplier & Procurement Models
// ==========================================

enum SupplierStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum VendorBillStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

model Supplier {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  name             String
  status           SupplierStatus  @default(ACTIVE)
  email            String?
  phone            String?
  website          String?
  taxId            String?
  paymentTermsDays Int             @default(30)
  currency         String          @default("USD")
  leadTimeDays     Int             @default(7)
  addressLine1     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  notes            String?
  metadata         Json?
  createdByUserId  String?
  updatedByUserId  String?
  archivedAt       DateTime?
  archivedByUserId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  supplierItems    SupplierItem[]
  purchaseOrders   PurchaseOrder[]
  vendorBills      VendorBill[]
  priceBooks       PriceBook[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("supplier")
}

model SupplierItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  packId         String?
  pack           ItemPack?    @relation(fields: [packId], references: [id], onDelete: SetNull)
  supplierSku    String?
  unitCostCents  Int
  currency       String       @default("USD")
  minOrderQty    Int          @default(1)
  leadTimeDays   Int?
  isPreferred    Boolean      @default(false)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, supplierId, itemId])
  @@index([organizationId, itemId])
  @@index([organizationId, supplierId])
  @@map("supplier_item")
}

model PurchaseOrder {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poNumber          String
  supplierId        String
  supplier          Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  locationId        String
  location          Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status            PurchaseOrderStatus @default(DRAFT)
  currency          String              @default("USD")
  subtotalCents     Int                 @default(0)
  taxCents          Int                 @default(0)
  totalCents        Int                 @default(0)
  notes             String?
  expectedAt        DateTime?
  submittedAt       DateTime?
  submittedByUserId String?
  cancelledAt       DateTime?
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lines             PurchaseOrderLine[]
  goodsReceipts     GoodsReceipt[]
  vendorBills       VendorBill[]

  @@unique([organizationId, poNumber])
  @@index([organizationId, supplierId, status])
  @@index([organizationId, locationId])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id              String             @id @default(cuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  packId          String?
  pack            ItemPack?          @relation(fields: [packId], references: [id], onDelete: SetNull)
  unitsPerPack    Int                @default(1)
  orderedBaseQty  Int                @default(0)
  receivedBaseQty Int                @default(0)
  supplierSku     String?
  description     String?
  orderedQty      Int
  receivedQty     Int                @default(0)
  unitCostCents   Int
  lineTotalCents  Int
  pricingSnapshot Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  receiptLines    GoodsReceiptLine[]

  @@index([organizationId, purchaseOrderId])
  @@map("purchase_order_line")
}

model GoodsReceipt {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiptNumber    String
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  locationId       String
  location         Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  notes            String?
  receivedByUserId String?
  receivedAt       DateTime           @default(now())
  createdAt        DateTime           @default(now())
  lines            GoodsReceiptLine[]
  vendorBills      VendorBill[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, locationId])
  @@map("goods_receipt")
}

model GoodsReceiptLine {
  id                  String            @id @default(cuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  itemId              String
  item                Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  packId              String?
  unitsPerPack        Int               @default(1)
  receivedQty         Int
  receivedBaseQty     Int               @default(0)
  unitCostCents       Int
  createdAt           DateTime          @default(now())

  @@index([organizationId, goodsReceiptId])
  @@map("goods_receipt_line")
}

model VendorBill {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billNumber      String
  supplierId      String
  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceiptId  String?
  goodsReceipt    GoodsReceipt?    @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  status          VendorBillStatus @default(DRAFT)
  currency        String           @default("USD")
  subtotalCents   Int              @default(0)
  taxCents        Int              @default(0)
  totalCents      Int              @default(0)
  paidAmountCents Int              @default(0)
  issuedAt        DateTime         @default(now())
  dueAt           DateTime?
  paidAt          DateTime?
  voidedAt        DateTime?
  notes           String?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lines           VendorBillLine[]

  @@unique([organizationId, supplierId, billNumber])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, purchaseOrderId])
  @@map("vendor_bill")
}

model VendorBillLine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendorBillId   String
  vendorBill     VendorBill   @relation(fields: [vendorBillId], references: [id], onDelete: Cascade)
  itemId         String?
  item           Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  description    String
  quantity       Int
  unitCostCents  Int
  lineTotalCents Int
  createdAt      DateTime     @default(now())

  @@index([organizationId, vendorBillId])
  @@map("vendor_bill_line")
}

// ==========================================
// Organization Object Storage (RustFS) Models
// ==========================================

enum StoredObjectStatus {
  PENDING
  READY
  DELETED
}

enum StorageEntityType {
  ORGANIZATION
  ITEM
  VENDOR_BILL
  PURCHASE_ORDER
  GOODS_RECEIPT
  SUPPLIER
}

model StoredObject {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bucket           String
  objectKey        String
  originalName     String
  mimeType         String
  sizeBytes        BigInt             @default(0)
  etag             String?
  status           StoredObjectStatus @default(PENDING)
  entityType       StorageEntityType  @default(ORGANIZATION)
  entityId         String?
  uploadedByUserId String?
  tags             String[]           @default([])
  metadata         Json?
  completedAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([organizationId, bucket, objectKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("stored_object")
}

// ==========================================
// Staff Management, Teams & Calendar Models
// ==========================================

enum DepartmentStatus {
  ACTIVE
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum StaffStatus {
  PREBOARDING
  ACTIVE
  ON_LEAVE
  OFFBOARDED
}

enum LeaveType {
  VACATION
  SICK
  PERSONAL
  PARENTAL
  UNPAID
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TeamKind {
  PROJECT
  RESOURCE_POOL
  DEPARTMENT
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum CalendarFeedScope {
  STAFF
  TEAM
  ORGANIZATION
}

model Department {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  code               String
  description        String?
  parentDepartmentId String?
  parentDepartment   Department?      @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments   Department[]     @relation("DepartmentHierarchy")
  leadStaffId        String?
  leadStaff          StaffProfile?    @relation("DepartmentLead", fields: [leadStaffId], references: [id], onDelete: SetNull)
  status             DepartmentStatus @default(ACTIVE)
  archivedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  staffMembers       StaffProfile[]   @relation("DepartmentStaff")
  teams              Team[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, parentDepartmentId])
  @@map("department")
}

model WorkSchedule {
  id                    String         @id @default(cuid())
  organizationId        String
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  timezone              String         @default("UTC")
  weeklyCapacityMinutes Int            @default(2400)
  workingDays           Json
  isDefault             Boolean        @default(false)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  staffProfiles         StaffProfile[]

  @@unique([organizationId, name])
  @@index([organizationId, isDefault, isActive])
  @@map("work_schedule")
}

model StaffProfile {
  id                    String           @id @default(cuid())
  organizationId        String
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId              String?          @unique
  member                Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  employeeCode          String?
  firstName             String
  lastName              String
  displayName           String
  workEmail             String
  phone                 String?
  jobTitle              String?
  departmentId          String?
  department            Department?      @relation("DepartmentStaff", fields: [departmentId], references: [id], onDelete: SetNull)
  managerStaffId        String?
  manager               StaffProfile?    @relation("StaffReporting", fields: [managerStaffId], references: [id], onDelete: SetNull)
  directReports         StaffProfile[]   @relation("StaffReporting")
  locationId            String?
  location              Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  workScheduleId        String?
  workSchedule          WorkSchedule?    @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  employmentType        EmploymentType   @default(FULL_TIME)
  status                StaffStatus      @default(ACTIVE)
  startDate             DateTime?
  endDate               DateTime?
  timezone              String           @default("UTC")
  weeklyCapacityMinutes Int              @default(2400)
  skills                String[]         @default([])
  bio                   String?
  metadata              Json?
  createdByUserId       String?
  updatedByUserId       String?
  offboardedAt          DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  ledDepartments        Department[]     @relation("DepartmentLead")
  ledTeams              Team[]           @relation("TeamLead")
  teamMemberships       TeamMember[]
  timeOffRequests       TimeOffRequest[] @relation("StaffTimeOff")
  reviewedTimeOff       TimeOffRequest[] @relation("TimeOffReviewer")
  calendarFeeds         CalendarFeed[]
  crmStaffMapping       CrmStaffMapping?

  @@unique([organizationId, workEmail])
  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, managerStaffId])
  @@map("staff_profile")
}

model Holiday {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  date              DateTime
  isRecurringAnnual Boolean      @default(false)
  isHalfDay         Boolean      @default(false)
  locationId        String?
  location          Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  notes             String?
  createdByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, date])
  @@index([organizationId, locationId])
  @@map("holiday")
}

model TimeOffRequest {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId           String
  staff             StaffProfile  @relation("StaffTimeOff", fields: [staffId], references: [id], onDelete: Cascade)
  leaveType         LeaveType
  startDate         DateTime
  endDate           DateTime
  totalMinutes      Int
  status            TimeOffStatus @default(PENDING)
  reason            String?
  reviewedByStaffId String?
  reviewedByStaff   StaffProfile? @relation("TimeOffReviewer", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNote        String?
  createdByUserId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId, staffId, status])
  @@index([organizationId, startDate, endDate])
  @@map("time_off_request")
}

model Team {
  id                   String         @id @default(cuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String
  description          String?
  kind                 TeamKind       @default(PROJECT)
  status               TeamStatus     @default(ACTIVE)
  departmentId         String?
  department           Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leadStaffId          String?
  leadStaff            StaffProfile?  @relation("TeamLead", fields: [leadStaffId], references: [id], onDelete: SetNull)
  defaultAllocationPct Int            @default(100)
  metadata             Json?
  archivedAt           DateTime?
  createdByUserId      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  members              TeamMember[]
  calendarFeeds        CalendarFeed[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, kind])
  @@map("team")
}

model TeamMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staffId        String
  staff          StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  roleInTeam     String       @default("member")
  allocationPct  Int          @default(100)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, teamId, staffId])
  @@index([organizationId, staffId])
  @@map("team_member")
}

model CalendarFeed {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  scope           CalendarFeedScope
  staffId         String?
  staff           StaffProfile?     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tokenHash       String            @unique
  includeTimeOff  Boolean           @default(true)
  includeHolidays Boolean           @default(true)
  includeShifts   Boolean           @default(false)
  revokedAt       DateTime?
  lastAccessedAt  DateTime?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([organizationId, scope])
  @@index([organizationId, staffId])
  @@index([organizationId, teamId])
  @@map("calendar_feed")
}

// ==========================================
// CustomerMates CRM Integration Models
// ==========================================

enum CrmProvider {
  CUSTOMERMATES
}

enum CrmWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

model CrmConnection {
  id                     String      @id @default(cuid())
  organizationId         String      @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider               CrmProvider @default(CUSTOMERMATES)
  baseUrl                String
  workspaceId            String?
  apiKeyEncrypted        String
  apiKeyLast4            String
  webhookSecretEncrypted String?
  isEnabled              Boolean     @default(true)
  sandboxMode            Boolean     @default(false)
  lastTestedAt           DateTime?
  lastTestStatus         String?
  lastTestMessage        String?
  createdByUserId        String?
  updatedByUserId        String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@map("crm_connection")
}

model CrmStaffMapping {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId         String       @unique
  staff           StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  externalUserId  String
  externalEmail   String?
  externalName    String?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, externalUserId])
  @@index([organizationId, staffId])
  @@map("crm_staff_mapping")
}

model CrmDealItemLink {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalDealId    String
  itemId            String
  item              Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  packId            String?
  pack              ItemPack?    @relation(fields: [packId], references: [id], onDelete: SetNull)
  servicePlanId     String?
  servicePlan       ServicePlan? @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  priceBookId       String?
  priceBook         PriceBook?   @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  promoCode         String?
  externalServiceId String?
  quantity          Int          @default(1)
  unitPriceCents    Int
  baseSubtotalCents Int?
  discountCents     Int          @default(0)
  currency          String       @default("USD")
  appliedPricing    Json?
  notes             String?
  createdByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, externalDealId, itemId])
  @@index([organizationId, externalDealId])
  @@index([organizationId, itemId])
  @@map("crm_deal_item_link")
}

model CrmWebhookEvent {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryId         String?
  eventType          String
  externalEntityType String?
  externalEntityId   String?
  signatureValid     Boolean          @default(false)
  status             CrmWebhookStatus @default(RECEIVED)
  payload            Json
  errorMessage       String?
  receivedAt         DateTime         @default(now())
  processedAt        DateTime?

  @@unique([organizationId, deliveryId])
  @@index([organizationId, eventType, receivedAt])
  @@map("crm_webhook_event")
}

// ==========================================
// Enterprise Packaging, Bundles, Service Plans & Pricing Models
// ==========================================

enum ServicePlanType {
  RETAINER
  HOUR_PACK
  SUBSCRIPTION
  MILESTONE
}

enum BillingCycle {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PriceBookDirection {
  SALES
  PURCHASE
}

enum PricingModel {
  FLAT
  VOLUME
  GRADUATED
  PACKAGE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
  BUY_X_GET_Y
}

enum DiscountScope {
  LINE_ITEM
  ORDER
}

model ItemPack {
  id                    String                @id @default(cuid())
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId                String
  item                  Item                  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  unitOfMeasure         String
  unitsPerPack          Int                   @default(1)
  barcode               String?
  packSku               String?
  salePriceCents        Int?
  costPriceCents        Int?
  isSellable            Boolean               @default(true)
  isPurchasable         Boolean               @default(true)
  isDefaultSalesPack    Boolean               @default(false)
  isDefaultPurchasePack Boolean               @default(false)
  minOrderPacks         Int                   @default(1)
  packStep              Int                   @default(1)
  weightGrams           Int?
  dimensionsJson        Json?
  isActive              Boolean               @default(true)
  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  bundleComponents      ItemBundleComponent[]
  priceRules            PriceRule[]
  discountRules         DiscountRule[]
  supplierItems         SupplierItem[]
  purchaseOrderLines    PurchaseOrderLine[]
  crmDealLinks          CrmDealItemLink[]

  @@unique([organizationId, itemId, code])
  @@index([organizationId, itemId, isActive])
  @@index([organizationId, packSku])
  @@map("item_pack")
}

model ItemBundleComponent {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bundleItemId       String
  bundleItem         Item         @relation("BundleParentItem", fields: [bundleItemId], references: [id], onDelete: Cascade)
  componentItemId    String
  componentItem      Item         @relation("BundleComponentItem", fields: [componentItemId], references: [id], onDelete: Restrict)
  componentPackId    String?
  componentPack      ItemPack?    @relation(fields: [componentPackId], references: [id], onDelete: SetNull)
  quantity           Int          @default(1)
  priceAllocationBps Int?
  isOptional         Boolean      @default(false)
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, bundleItemId, componentItemId])
  @@index([organizationId, bundleItemId])
  @@map("item_bundle_component")
}

model ServicePlan {
  id                    String            @id @default(cuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId                String
  item                  Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  description           String?
  planType              ServicePlanType   @default(HOUR_PACK)
  billingCycle          BillingCycle      @default(ONE_TIME)
  includedUnits         Int               @default(1)
  unitLabel             String            @default("hours")
  basePriceCents        Int
  overageUnitPriceCents Int?
  setupFeeCents         Int               @default(0)
  rolloverEnabled       Boolean           @default(false)
  maxRolloverUnits      Int?
  validityDays          Int?
  isActive              Boolean           @default(true)
  metadata              Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  priceRules            PriceRule[]
  crmDealLinks          CrmDealItemLink[]

  @@unique([organizationId, itemId, code])
  @@index([organizationId, itemId, isActive])
  @@map("service_plan")
}

model PriceBook {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  name              String
  description       String?
  direction         PriceBookDirection @default(SALES)
  currency          String             @default("USD")
  priority          Int                @default(100)
  isDefault         Boolean            @default(false)
  isActive          Boolean            @default(true)
  customerSegment   String?
  externalAccountId String?
  supplierId        String?
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  startsAt          DateTime?
  endsAt            DateTime?
  customAttributes  Json?
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  rules             PriceRule[]
  crmDealLinks      CrmDealItemLink[]

  @@unique([organizationId, code])
  @@index([organizationId, direction, isActive, priority])
  @@index([organizationId, customerSegment])
  @@index([organizationId, externalAccountId])
  @@index([organizationId, supplierId])
  @@map("price_book")
}

model PriceRule {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceBookId        String
  priceBook          PriceBook    @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  itemId             String
  item               Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  packId             String?
  pack               ItemPack?    @relation(fields: [packId], references: [id], onDelete: SetNull)
  servicePlanId      String?
  servicePlan        ServicePlan? @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  name               String
  pricingModel       PricingModel @default(FLAT)
  baseUnitPriceCents Int
  minMarginBps       Int?
  minQuantity        Int          @default(1)
  maxQuantity        Int?
  conditions         Json?
  customAdjustment   Json?
  priority           Int          @default(100)
  isActive           Boolean      @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  tiers              PriceTier[]

  @@index([organizationId, priceBookId, itemId, isActive])
  @@index([organizationId, itemId, packId])
  @@map("price_rule")
}

model PriceTier {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceRuleId       String
  priceRule         PriceRule    @relation(fields: [priceRuleId], references: [id], onDelete: Cascade)
  minQuantity       Int
  maxQuantity       Int?
  unitPriceCents    Int?
  flatFeeCents      Int?
  packageSize       Int?
  packagePriceCents Int?
  discountBps       Int?
  sortOrder         Int          @default(0)

  @@index([organizationId, priceRuleId, minQuantity])
  @@map("price_tier")
}

model DiscountRule {
  id                    String        @id @default(cuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  description           String?
  promoCode             String?
  discountType          DiscountType
  scope                 DiscountScope @default(LINE_ITEM)
  valueBps              Int?
  amountCents           Int?
  fixedPriceCents       Int?
  buyQuantity           Int?
  getQuantity           Int?
  getDiscountBps        Int?
  targetItemId          String?
  targetItem            Item?         @relation(fields: [targetItemId], references: [id], onDelete: SetNull)
  targetPackId          String?
  targetPack            ItemPack?     @relation(fields: [targetPackId], references: [id], onDelete: SetNull)
  targetTags            String[]      @default([])
  customerSegments      String[]      @default([])
  externalAccountIds    String[]      @default([])
  minQuantity           Int?
  minOrderSubtotalCents Int?
  maxDiscountCents      Int?
  isStackable           Boolean       @default(false)
  priority              Int           @default(100)
  startsAt              DateTime?
  endsAt                DateTime?
  usageLimit            Int?
  usageCount            Int           @default(0)
  isActive              Boolean       @default(true)
  conditions            Json?
  createdByUserId       String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, isActive, promoCode])
  @@index([organizationId, targetItemId])
  @@map("discount_rule")
}




