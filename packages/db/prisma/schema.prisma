// ==========================================
// Staff Management, Teams & Calendar Models
// ==========================================

enum DepartmentStatus {
  ACTIVE
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum StaffStatus {
  PREBOARDING
  ACTIVE
  ON_LEAVE
  OFFBOARDED
}

enum LeaveType {
  VACATION
  SICK
  PERSONAL
  PARENTAL
  UNPAID
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TeamKind {
  PROJECT
  RESOURCE_POOL
  DEPARTMENT
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

enum CalendarFeedScope {
  STAFF
  TEAM
  ORGANIZATION
}

model Department {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  code               String
  description        String?
  parentDepartmentId String?
  parentDepartment   Department?      @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  childDepartments   Department[]     @relation("DepartmentHierarchy")
  leadStaffId        String?
  leadStaff          StaffProfile?    @relation("DepartmentLead", fields: [leadStaffId], references: [id], onDelete: SetNull)
  status             DepartmentStatus @default(ACTIVE)
  archivedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  staffMembers       StaffProfile[]   @relation("DepartmentStaff")
  teams              Team[]
  staffJobs          StaffJob[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, parentDepartmentId])
  @@map("department")
}

model WorkSchedule {
  id                    String         @id @default(cuid())
  organizationId        String
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  timezone              String         @default("UTC")
  weeklyCapacityMinutes Int            @default(2400)
  workingDays           Json
  isDefault             Boolean        @default(false)
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  staffProfiles         StaffProfile[]

  @@unique([organizationId, name])
  @@index([organizationId, isDefault, isActive])
  @@map("work_schedule")
}

model StaffProfile {
  id                    String           @id @default(cuid())
  organizationId        String
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberId              String?          @unique
  member                Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  employeeCode          String?
  firstName             String
  lastName              String
  displayName           String
  workEmail             String
  phone                 String?
  jobTitle              String?
  departmentId          String?
  department            Department?      @relation("DepartmentStaff", fields: [departmentId], references: [id], onDelete: SetNull)
  managerStaffId        String?
  manager               StaffProfile?    @relation("StaffReporting", fields: [managerStaffId], references: [id], onDelete: SetNull)
  directReports         StaffProfile[]   @relation("StaffReporting")
  locationId            String?
  location              Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  workScheduleId        String?
  workSchedule          WorkSchedule?    @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  employmentType        EmploymentType   @default(FULL_TIME)
  status                StaffStatus      @default(ACTIVE)
  startDate             DateTime?
  endDate               DateTime?
  timezone              String           @default("UTC")
  weeklyCapacityMinutes Int              @default(2400)
  skills                String[]         @default([])
  bio                   String?
  metadata              Json?
  createdByUserId       String?
  updatedByUserId       String?
  offboardedAt          DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  ledDepartments        Department[]     @relation("DepartmentLead")
  ledTeams              Team[]           @relation("TeamLead")
  teamMemberships       TeamMember[]
  timeOffRequests       TimeOffRequest[] @relation("StaffTimeOff")
  reviewedTimeOff       TimeOffRequest[] @relation("TimeOffReviewer")
  calendarFeeds         CalendarFeed[]
  crmStaffMapping       CrmStaffMapping?
  courierFulfillments   OrderFulfillment[] @relation("FulfillmentCourier")
  assignedStaffJobs     StaffJob[]         @relation("StaffJobAssignee")

  @@unique([organizationId, workEmail])
  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([organizationId, departmentId])
  @@index([organizationId, managerStaffId])
  @@map("staff_profile")
}

model Holiday {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  date              DateTime
  isRecurringAnnual Boolean      @default(false)
  isHalfDay         Boolean      @default(false)
  locationId        String?
  location          Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  notes             String?
  createdByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, date])
  @@index([organizationId, locationId])
  @@map("holiday")
}

model TimeOffRequest {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId           String
  staff             StaffProfile  @relation("StaffTimeOff", fields: [staffId], references: [id], onDelete: Cascade)
  leaveType         LeaveType
  startDate         DateTime
  endDate           DateTime
  totalMinutes      Int
  status            TimeOffStatus @default(PENDING)
  reason            String?
  reviewedByStaffId String?
  reviewedByStaff   StaffProfile? @relation("TimeOffReviewer", fields: [reviewedByStaffId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNote        String?
  createdByUserId   String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId, staffId, status])
  @@index([organizationId, startDate, endDate])
  @@map("time_off_request")
}

model Team {
  id                   String         @id @default(cuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  slug                 String
  description          String?
  kind                 TeamKind       @default(PROJECT)
  status               TeamStatus     @default(ACTIVE)
  departmentId         String?
  department           Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  leadStaffId          String?
  leadStaff            StaffProfile?  @relation("TeamLead", fields: [leadStaffId], references: [id], onDelete: SetNull)
  defaultAllocationPct Int            @default(100)
  metadata             Json?
  archivedAt           DateTime?
  createdByUserId      String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  members              TeamMember[]
  calendarFeeds        CalendarFeed[]
  staffJobs            StaffJob[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, kind])
  @@map("team")
}

model TeamMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staffId        String
  staff          StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  roleInTeam     String       @default("member")
  allocationPct  Int          @default(100)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, teamId, staffId])
  @@index([organizationId, staffId])
  @@map("team_member")
}

model CalendarFeed {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  scope           CalendarFeedScope
  staffId         String?
  staff           StaffProfile?     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  teamId          String?
  team            Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tokenHash       String            @unique
  includeTimeOff  Boolean           @default(true)
  includeHolidays Boolean           @default(true)
  includeShifts   Boolean           @default(false)
  revokedAt       DateTime?
  lastAccessedAt  DateTime?
  createdByUserId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([organizationId, scope])
  @@index([organizationId, staffId])
  @@index([organizationId, teamId])
  @@map("calendar_feed")
}

// ==========================================
// CustomerMates CRM Integration Models
// ==========================================

enum CrmProvider {
  CUSTOMERMATES
}

enum CrmWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

model CrmConnection {
  id                     String      @id @default(cuid())
  organizationId         String      @unique
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider               CrmProvider @default(CUSTOMERMATES)
  baseUrl                String
  workspaceId            String?
  apiKeyEncrypted        String
  apiKeyLast4            String
  webhookSecretEncrypted String?
  isEnabled              Boolean     @default(true)
  sandboxMode            Boolean     @default(false)
  lastTestedAt           DateTime?
  lastTestStatus         String?
  lastTestMessage        String?
  createdByUserId        String?
  updatedByUserId        String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@map("crm_connection")
}

model CrmStaffMapping {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffId         String       @unique
  staff           StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  externalUserId  String
  externalEmail   String?
  externalName    String?
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, externalUserId])
  @@index([organizationId, staffId])
  @@map("crm_staff_mapping")
}

model CrmDealItemLink {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalDealId    String
  itemId            String
  item              Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  packId            String?
  pack              ItemPack?    @relation(fields: [packId], references: [id], onDelete: SetNull)
  servicePlanId     String?
  servicePlan       ServicePlan? @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  priceBookId       String?
  priceBook         PriceBook?   @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  promoCode         String?
  externalServiceId String?
  quantity          Int          @default(1)
  unitPriceCents    Int
  baseSubtotalCents Int?
  discountCents     Int          @default(0)
  currency          String       @default("USD")
  appliedPricing    Json?
  notes             String?
  createdByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, externalDealId, itemId])
  @@index([organizationId, externalDealId])
  @@index([organizationId, itemId])
  @@map("crm_deal_item_link")
}

model CrmWebhookEvent {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryId         String?
  eventType          String
  externalEntityType String?
  externalEntityId   String?
  signatureValid     Boolean          @default(false)
  status             CrmWebhookStatus @default(RECEIVED)
  payload            Json
  errorMessage       String?
  receivedAt         DateTime         @default(now())
  processedAt        DateTime?

  @@unique([organizationId, deliveryId])
  @@index([organizationId, eventType, receivedAt])
  @@map("crm_webhook_event")
}

// ==========================================
// Enterprise Packaging, Bundles, Service Plans & Pricing Models
// ==========================================

enum ServicePlanType {
  RETAINER
  HOUR_PACK
  SUBSCRIPTION
  MILESTONE
}

enum BillingCycle {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum PriceBookDirection {
  SALES
  PURCHASE
}

enum PricingModel {
  FLAT
  VOLUME
  GRADUATED
  PACKAGE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
  BUY_X_GET_Y
}

enum DiscountScope {
  LINE_ITEM
  ORDER
}

model ItemPack {
  id                    String                @id @default(cuid())
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId                String
  item                  Item                  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  unitOfMeasure         String
  unitsPerPack          Int                   @default(1)
  barcode               String?
  packSku               String?
  salePriceCents        Int?
  costPriceCents        Int?
  isSellable            Boolean               @default(true)
  isPurchasable         Boolean               @default(true)
  isDefaultSalesPack    Boolean               @default(false)
  isDefaultPurchasePack Boolean               @default(false)
  minOrderPacks         Int                   @default(1)
  packStep              Int                   @default(1)
  weightGrams           Int?
  dimensionsJson        Json?
  isActive              Boolean               @default(true)
  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  bundleComponents      ItemBundleComponent[]
  priceRules            PriceRule[]
  discountRules         DiscountRule[]
  supplierItems         SupplierItem[]
  purchaseOrderLines    PurchaseOrderLine[]
  goodsReceiptLines     GoodsReceiptLine[]
  crmDealLinks          CrmDealItemLink[]
  orderLines            OrderLine[]

  @@unique([organizationId, itemId, code])
  @@index([organizationId, itemId, isActive])
  @@index([organizationId, packSku])
  @@map("item_pack")
}

model ItemBundleComponent {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bundleItemId       String
  bundleItem         Item         @relation("BundleParentItem", fields: [bundleItemId], references: [id], onDelete: Cascade)
  componentItemId    String
  componentItem      Item         @relation("BundleComponentItem", fields: [componentItemId], references: [id], onDelete: Restrict)
  componentPackId    String?
  componentPack      ItemPack?    @relation(fields: [componentPackId], references: [id], onDelete: SetNull)
  quantity           Int          @default(1)
  priceAllocationBps Int?
  isOptional         Boolean      @default(false)
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, bundleItemId, componentItemId])
  @@index([organizationId, bundleItemId])
  @@map("item_bundle_component")
}

model ServicePlan {
  id                    String            @id @default(cuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  itemId                String
  item                  Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  description           String?
  planType              ServicePlanType   @default(HOUR_PACK)
  billingCycle          BillingCycle      @default(ONE_TIME)
  includedUnits         Int               @default(1)
  unitLabel             String            @default("hours")
  basePriceCents        Int
  overageUnitPriceCents Int?
  setupFeeCents         Int               @default(0)
  rolloverEnabled       Boolean           @default(false)
  maxRolloverUnits      Int?
  validityDays          Int?
  isActive              Boolean           @default(true)
  metadata              Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  priceRules            PriceRule[]
  crmDealLinks          CrmDealItemLink[]
  orderLines            OrderLine[]

  @@unique([organizationId, itemId, code])
  @@index([organizationId, itemId, isActive])
  @@map("service_plan")
}

model PriceBook {
  id                String             @id @default(cuid())
  organizationId    String
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String
  name              String
  description       String?
  direction         PriceBookDirection @default(SALES)
  currency          String             @default("USD")
  priority          Int                @default(100)
  isDefault         Boolean            @default(false)
  isActive          Boolean            @default(true)
  customerSegment   String?
  externalAccountId String?
  supplierId        String?
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  startsAt          DateTime?
  endsAt            DateTime?
  customAttributes  Json?
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  rules             PriceRule[]
  crmDealLinks      CrmDealItemLink[]
  orders            Order[]

  @@unique([organizationId, code])
  @@index([organizationId, direction, isActive, priority])
  @@index([organizationId, customerSegment])
  @@index([organizationId, externalAccountId])
  @@index([organizationId, supplierId])
  @@map("price_book")
}

model PriceRule {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceBookId        String
  priceBook          PriceBook    @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  itemId             String
  item               Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  packId             String?
  pack               ItemPack?    @relation(fields: [packId], references: [id], onDelete: SetNull)
  servicePlanId      String?
  servicePlan        ServicePlan? @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  name               String
  pricingModel       PricingModel @default(FLAT)
  baseUnitPriceCents Int
  minMarginBps       Int?
  minQuantity        Int          @default(1)
  maxQuantity        Int?
  conditions         Json?
  customAdjustment   Json?
  priority           Int          @default(100)
  isActive           Boolean      @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  tiers              PriceTier[]

  @@index([organizationId, priceBookId, itemId, isActive])
  @@index([organizationId, itemId, packId])
  @@map("price_rule")
}

model PriceTier {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priceRuleId       String
  priceRule         PriceRule    @relation(fields: [priceRuleId], references: [id], onDelete: Cascade)
  minQuantity       Int
  maxQuantity       Int?
  unitPriceCents    Int?
  flatFeeCents      Int?
  packageSize       Int?
  packagePriceCents Int?
  discountBps       Int?
  sortOrder         Int          @default(0)

  @@index([organizationId, priceRuleId, minQuantity])
  @@map("price_tier")
}

model DiscountRule {
  id                    String        @id @default(cuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  description           String?
  promoCode             String?
  discountType          DiscountType
  scope                 DiscountScope @default(LINE_ITEM)
  valueBps              Int?
  amountCents           Int?
  fixedPriceCents       Int?
  buyQuantity           Int?
  getQuantity           Int?
  getDiscountBps        Int?
  targetItemId          String?
  targetItem            Item?         @relation(fields: [targetItemId], references: [id], onDelete: SetNull)
  targetPackId          String?
  targetPack            ItemPack?     @relation(fields: [targetPackId], references: [id], onDelete: SetNull)
  targetTags            String[]      @default([])
  customerSegments      String[]      @default([])
  externalAccountIds    String[]      @default([])
  minQuantity           Int?
  minOrderSubtotalCents Int?
  maxDiscountCents      Int?
  isStackable           Boolean       @default(false)
  priority              Int           @default(100)
  startsAt              DateTime?
  endsAt                DateTime?
  usageLimit            Int?
  usageCount            Int           @default(0)
  isActive              Boolean       @default(true)
  conditions            Json?
  createdByUserId       String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, isActive, promoCode])
  @@index([organizationId, targetItemId])
  @@map("discount_rule")
}

// ==========================================
// Customers, Orders (POS & B2B), Invoices, Cash Payments & Receipts
// ==========================================

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderChannel {
  POS
  B2B
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  COMPLETED
  CANCELLED
}

enum SalesInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
}

enum CustomerPaymentStatus {
  COMPLETED
  VOIDED
}

model Customer {
  id                   String            @id @default(cuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                 String
  type                 CustomerType      @default(INDIVIDUAL)
  status               CustomerStatus    @default(ACTIVE)
  name                 String
  companyName          String?
  email                String?
  phone                String?
  taxId                String?
  customerSegment      String?
  currency             String            @default("USD")
  paymentTermsDays     Int               @default(0)
  billingAddressLine1  String?
  billingAddressLine2  String?
  billingCity          String?
  billingState         String?
  billingPostalCode    String?
  billingCountry       String?
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingCity         String?
  shippingState        String?
  shippingPostalCode   String?
  shippingCountry      String?
  crmProvider          CrmProvider?
  externalContactId    String?
  externalCompanyId    String?
  externalAccountId    String?
  crmLastSyncedAt      DateTime?
  notes                String?
  metadata             Json?
  createdByUserId      String?
  updatedByUserId      String?
  archivedAt           DateTime?
  archivedByUserId     String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  orders               Order[]
  invoices             SalesInvoice[]
  payments             CustomerPayment[]
  receipts             PaymentReceipt[]
  fulfillments         OrderFulfillment[]
  notifications        CustomerNotification[]

  @@unique([organizationId, code])
  @@index([organizationId, status, type])
  @@index([organizationId, externalContactId])
  @@index([organizationId, externalCompanyId])
  @@index([organizationId, email])
  @@map("customer")
}

model Order {
  id                 String            @id @default(cuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderNumber        String
  channel            OrderChannel
  status             OrderStatus       @default(DRAFT)
  locationId         String
  location           Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customerId         String?
  customer           Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  priceBookId        String?
  priceBook          PriceBook?        @relation(fields: [priceBookId], references: [id], onDelete: SetNull)
  externalDealId     String?
  customerSegment    String?
  promoCodes         String[]          @default([])
  currency           String            @default("USD")
  subtotalCents      Int               @default(0)
  discountTotalCents Int               @default(0)
  taxCents           Int               @default(0)
  totalCents         Int               @default(0)
  paidAmountCents    Int               @default(0)
  notes              String?
  metadata           Json?
  confirmedAt        DateTime?
  confirmedByUserId  String?
  fulfilledAt        DateTime?
  fulfilledByUserId  String?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdByUserId    String?
  updatedByUserId    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lines              OrderLine[]
  invoices           SalesInvoice[]
  payments           CustomerPayment[]
  receipts           PaymentReceipt[]
  fulfillment        OrderFulfillment?
  staffJobs          StaffJob[]
  notifications      CustomerNotification[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, channel, status])
  @@index([organizationId, customerId])
  @@index([organizationId, locationId])
  @@index([organizationId, createdAt])
  @@map("sales_order")
}

model OrderLine {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId          String
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)
  packId           String?
  pack             ItemPack?          @relation(fields: [packId], references: [id], onDelete: SetNull)
  servicePlanId    String?
  servicePlan      ServicePlan?       @relation(fields: [servicePlanId], references: [id], onDelete: SetNull)
  sku              String
  name             String
  description      String?
  unitOfMeasure    String             @default("unit")
  unitsPerPack     Int                @default(1)
  quantity         Int
  fulfilledQty     Int                @default(0)
  orderedBaseQty   Int                @default(0)
  reservedBaseQty  Int                @default(0)
  fulfilledBaseQty Int                @default(0)
  bonusUnits       Int                @default(0)
  unitPriceCents   Int
  discountCents    Int                @default(0)
  lineTotalCents   Int
  pricingSnapshot  Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  invoiceLines     SalesInvoiceLine[]

  @@index([organizationId, orderId])
  @@index([organizationId, itemId])
  @@map("sales_order_line")
}

model SalesInvoice {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceNumber        String
  orderId              String
  order                Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerId           String?
  customer             Customer?          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status               SalesInvoiceStatus @default(DRAFT)
  currency             String             @default("USD")
  subtotalCents        Int                @default(0)
  discountTotalCents   Int                @default(0)
  taxCents             Int                @default(0)
  totalCents           Int                @default(0)
  paidAmountCents      Int                @default(0)
  issuedAt             DateTime?
  dueAt                DateTime?
  paidAt               DateTime?
  voidedAt             DateTime?
  voidReason           String?
  notes                String?
  customerSnapshot     Json?
  organizationSnapshot Json?
  createdByUserId      String?
  updatedByUserId      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  lines                SalesInvoiceLine[]
  payments             CustomerPayment[]
  receipts             PaymentReceipt[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, dueAt])
  @@index([organizationId, orderId])
  @@index([organizationId, customerId])
  @@map("sales_invoice")
}

model SalesInvoiceLine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  orderLineId    String?
  orderLine      OrderLine?   @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  itemId         String?
  item           Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  sku            String?
  description    String
  unitOfMeasure  String       @default("unit")
  quantity       Int
  unitPriceCents Int
  discountCents  Int          @default(0)
  lineTotalCents Int
  createdAt      DateTime     @default(now())

  @@index([organizationId, salesInvoiceId])
  @@map("sales_invoice_line")
}

model CustomerPayment {
  id                 String                @id @default(cuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentNumber      String
  orderId            String
  order              Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  salesInvoiceId     String?
  salesInvoice       SalesInvoice?         @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  customerId         String?
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  method             PaymentMethod         @default(CASH)
  status             CustomerPaymentStatus @default(COMPLETED)
  currency           String                @default("USD")
  amountAppliedCents Int
  cashTenderedCents  Int
  changeGivenCents   Int                   @default(0)
  reference          String?
  notes              String?
  receivedByUserId   String?
  receivedAt         DateTime              @default(now())
  voidedAt           DateTime?
  voidReason         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  receipt            PaymentReceipt?

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, orderId])
  @@index([organizationId, salesInvoiceId])
  @@index([organizationId, customerId])
  @@map("customer_payment")
}

model PaymentReceipt {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiptNumber     String
  paymentId         String          @unique
  payment           CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  salesInvoiceId    String?
  salesInvoice      SalesInvoice?   @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  channel           OrderChannel
  currency          String          @default("USD")
  totalCents        Int
  cashTenderedCents Int
  changeGivenCents  Int             @default(0)
  snapshot          Json
  issuedAt          DateTime        @default(now())
  issuedByUserId    String?
  createdAt         DateTime        @default(now())

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, orderId])
  @@index([organizationId, customerId])
  @@index([organizationId, issuedAt])
  @@map("payment_receipt")
}

// ==========================================
// Order Fulfillment (Preorders, Pickups, Deliveries), Staff Jobs & Notifications
// ==========================================

enum FulfillmentType {
  PREORDER
  PICKUP
  DELIVERY
}

enum FulfillmentStatus {
  PENDING
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum DeliveryStage {
  NONE
  OUT_FOR_DELIVERY
  DELIVERED
}

enum PreorderDepositStatus {
  NOT_REQUIRED
  UNPAID
  DEPOSIT_PAID
  PAID
}

enum StaffJobStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CommunicationChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum NotificationEventType {
  PREORDER_READY
  JOB_COMPLETED
  DELIVERY_OUT_FOR_DELIVERY
  DELIVERY_DELIVERED
  CUSTOM
}

enum NotificationDeliveryStatus {
  SENT
  SANDBOX
  FALLBACK_SENT
  SKIPPED_DISABLED
  FAILED
}

model FulfillmentSettings {
  id                           String               @id @default(cuid())
  organizationId               String               @unique
  organization                 Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  autoConvertPreordersToJobs   Boolean              @default(false)
  defaultJobLeadMinutes        Int                  @default(120)
  defaultJobAssigneeStaffId    String?
  defaultJobAssigneeRole       String?
  syncJobsToCrm                Boolean              @default(false)
  defaultChannel               CommunicationChannel @default(SMS)
  autoNotifyOnPreorderReady    Boolean              @default(true)
  autoNotifyOnJobCompleted     Boolean              @default(true)
  autoNotifyOnDeliveryUpdates  Boolean              @default(true)
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  @@map("fulfillment_settings")
}

model OrderFulfillment {
  id                         String                 @id @default(cuid())
  organizationId             String
  organization               Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fulfillmentNumber          String
  orderId                    String                 @unique
  order                      Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  locationId                 String
  location                   Location               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  customerId                 String?
  customer                   Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  type                       FulfillmentType
  status                     FulfillmentStatus      @default(PENDING)
  deliveryStage              DeliveryStage          @default(NONE)
  stockReserved              Boolean                @default(false)
  stockDeducted              Boolean                @default(false)
  scheduledFulfillmentAt     DateTime?
  depositRequiredCents       Int                    @default(0)
  depositStatus              PreorderDepositStatus  @default(NOT_REQUIRED)
  preparationNotes           String?
  autoConvertToJob           Boolean?
  pickupWindowStart          DateTime?
  pickupWindowEnd            DateTime?
  pickupInstructions         String?
  handoffConfirmedAt         DateTime?
  handoffConfirmedByUserId   String?
  deliveryAddressLine1       String?
  deliveryAddressLine2       String?
  deliveryCity               String?
  deliveryState              String?
  deliveryPostalCode         String?
  deliveryCountry            String?
  deliveryInstructions       String?
  deliveryWindowStart        DateTime?
  deliveryWindowEnd          DateTime?
  courierStaffId             String?
  courierStaff               StaffProfile?          @relation("FulfillmentCourier", fields: [courierStaffId], references: [id], onDelete: SetNull)
  courierName                String?
  courierPhone               String?
  outForDeliveryAt           DateTime?
  deliveredAt                DateTime?
  notificationsEnabled       Boolean                @default(true)
  preferredChannel           CommunicationChannel?
  notifyOnPreorderReady      Boolean                @default(true)
  notifyOnJobCompleted       Boolean                @default(true)
  notifyOnDeliveryUpdates    Boolean                @default(true)
  confirmedAt                DateTime?
  confirmedByUserId          String?
  readyAt                    DateTime?
  completedAt                DateTime?
  completedByUserId          String?
  cancelledAt                DateTime?
  cancelReason               String?
  metadata                   Json?
  createdByUserId            String?
  updatedByUserId            String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  staffJobs                  StaffJob[]
  notifications              CustomerNotification[]

  @@unique([organizationId, fulfillmentNumber])
  @@index([organizationId, type, status])
  @@index([organizationId, customerId])
  @@index([organizationId, locationId])
  @@index([organizationId, scheduledFulfillmentAt])
  @@map("order_fulfillment")
}

model StaffJob {
  id                   String                 @id @default(cuid())
  organizationId       String
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobNumber            String
  fulfillmentId        String
  fulfillment          OrderFulfillment       @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderId              String
  order                Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title                String
  instructions         String?
  status               StaffJobStatus         @default(ASSIGNED)
  priority             Int                    @default(2)
  assignedStaffId      String?
  assignedStaff        StaffProfile?          @relation("StaffJobAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignedDepartmentId String?
  assignedDepartment   Department?            @relation(fields: [assignedDepartmentId], references: [id], onDelete: SetNull)
  assignedTeamId       String?
  assignedTeam         Team?                  @relation(fields: [assignedTeamId], references: [id], onDelete: SetNull)
  assignedRole         String?
  targetDueAt          DateTime?
  startedAt            DateTime?
  startedByUserId      String?
  completedAt          DateTime?
  completedByUserId    String?
  cancelledAt          DateTime?
  syncToCrm            Boolean                @default(false)
  externalTaskId       String?
  crmSyncedAt          DateTime?
  metadata             Json?
  createdByUserId      String?
  updatedByUserId      String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  notifications        CustomerNotification[]

  @@unique([organizationId, jobNumber])
  @@index([organizationId, fulfillmentId, status])
  @@index([organizationId, assignedStaffId, status])
  @@index([organizationId, targetDueAt])
  @@map("staff_job")
}

model NotificationTemplate {
  id              String                @id @default(cuid())
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType       NotificationEventType
  channel         CommunicationChannel
  name            String
  subject         String?
  body            String
  isActive        Boolean               @default(true)
  updatedByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([organizationId, eventType, channel])
  @@index([organizationId, eventType])
  @@map("notification_template")
}

model CustomerNotification {
  id                String                     @id @default(cuid())
  organizationId    String
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fulfillmentId     String
  fulfillment       OrderFulfillment           @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderId           String
  order             Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staffJobId        String?
  staffJob          StaffJob?                  @relation(fields: [staffJobId], references: [id], onDelete: SetNull)
  customerId        String?
  customer          Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  eventType         NotificationEventType
  channel           CommunicationChannel
  triggerSource     String                     @default("AUTO")
  recipient         String?
  subject           String?
  message           String
  status            NotificationDeliveryStatus
  provider          String?
  externalMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  sentByUserId      String?
  createdAt         DateTime                   @default(now())

  @@index([organizationId, fulfillmentId, createdAt])
  @@index([organizationId, orderId])
  @@index([organizationId, customerId])
  @@map("customer_notification")
}

