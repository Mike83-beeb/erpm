{
  "name": "scace-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "predev": "pnpm --filter @scace/db build",
    "dev": "pnpm --filter @scace/api dev",
    "build": "pnpm --filter @scace/db build && pnpm --filter @scace/api build",
    "prelint": "pnpm --filter @scace/db build",
    "lint": "turbo run lint",
    "pretypecheck": "pnpm --filter @scace/db build",
    "typecheck": "turbo run typecheck",
    "start": "node apps/api/dist/main.js",
    "db:generate": "pnpm --filter @scace/db db:generate",
    "db:push": "pnpm --filter @scace/db db:push",
    "db:migrate": "pnpm --filter @scace/db db:migrate",
    "clean": "turbo run clean && rm -rf dist .turbo"
  },
  "devDependencies": {
    "pnpm": "^12.23.0",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  }
}